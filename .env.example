# Скопируйте в .env. Ключ читается только сервером.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
DEMO_MODE=true
# Защита API от частых запросов. Значения применяются только к /api/dialogue/analyze.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
# Включайте только за доверенным reverse proxy, который сам очищает X-Forwarded-For.
TRUST_PROXY=false
